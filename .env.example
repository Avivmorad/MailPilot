# Copy this file to .env.local and fill in the values.
# Never commit real secrets. All values below are placeholders.
#
# NOTE ON NAMING: some setup guides use different illustrative names. Map them
# to the actual variable names used by this project:
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY  ->  NEXT_PUBLIC_SUPABASE_ANON_KEY
#   SUPABASE_SECRET_KEY                   ->  SUPABASE_SERVICE_ROLE_KEY
#   OPENAI_API_KEY                        ->  GEMINI_API_KEY
#   OPENAI_MODEL                          ->  GEMINI_MODEL
# Use the names below; they are what the code in src/lib/config/env.ts validates.

# Public app URL (used for OAuth redirects and absolute links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth (Gmail authorization)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/callback

# 32-byte key for AES-256-GCM refresh-token encryption
# (e.g. a 64-char hex string: `openssl rand -hex 32`)
TOKEN_ENCRYPTION_KEY=

# Gemini (structured JSON via @google/genai)
GEMINI_API_KEY=
# Model is configurable; do not hard-code it in source.
GEMINI_MODEL=gemini-3.1-flash-lite

# Protects the cron dispatcher endpoint
CRON_SECRET=

# Sentry (optional). The DSN is public; do not put auth tokens here.
# Never send Gmail bodies, OAuth tokens, or email addresses to Sentry.
NEXT_PUBLIC_SENTRY_DSN=
# Build-only source-map upload. Leave unset in local/dev builds.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Cost / context controls (optional; defaults shown)
MAX_THREAD_MESSAGES=6
MAX_MESSAGE_CHARS=12000
MAX_THREAD_CHARS=35000
AI_MAX_CONCURRENCY=2
# Pause Gmail calls before hitting Google's ~15,000 units/user/minute cap
GMAIL_QUOTA_UNITS_PER_MINUTE=12000
